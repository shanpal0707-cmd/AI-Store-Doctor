# ============================================================
# AI Store Doctor — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Authentication ────────────────────────────────────────────
# Secret key used to sign JSON Web Tokens.
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER share or commit this value.
JWT_SECRET=replace_with_a_long_random_secret_string

# ── MongoDB Atlas ────────────────────────────────────────────
# Paste your full Atlas connection string here.
# Format:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Get it from: Atlas → Connect → Drivers → Node.js
# NEVER expose this value to Angular or any frontend code.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-store-doctor?retryWrites=true&w=majority

# ── AI Provider ──────────────────────────────────────────────
# Set to "gemini" (default) or "granite"
AI_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── IBM watsonx.ai / Granite ──────────────────────────────────
# Only required when AI_PROVIDER=granite
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_project_id_here
IBM_REGION=us-south
